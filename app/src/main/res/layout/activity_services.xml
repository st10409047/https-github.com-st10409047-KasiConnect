<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1976D2">

        <TextView
            android:id="@+id/tvServicesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local Services"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServicesSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Find services in your community"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Search -->
            <EditText
                android:id="@+id/etSearchServices"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Search for a service..."
                android:inputType="text"
                android:padding="15dp"
                android:textSize="16sp" />

            <!-- Category Title -->
            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Service Categories"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlumbers"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Plumbers"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnElectricians"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Electricians"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHairdressers"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Hairdressers"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnMechanics"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Mechanics"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCleaning"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Cleaning"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnTutors"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Tutors"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGardeners"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Gardeners"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnOtherServices"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Other Services"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Nearby Services -->
            <TextView
                android:id="@+id/tvNearbyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Popular Near You"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNearbyServices"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:text="View Services Near Me"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Services"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
